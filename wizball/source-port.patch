--- /dev/null
+++ b/wizball/atomic_file.h
@@ -0,0 +1,8 @@
+#ifndef WIZBALL_ATOMIC_FILE_H
+#define WIZBALL_ATOMIC_FILE_H
+#include <stdio.h>
+// Stage beside the destination so rename is atomic on the same filesystem.
+FILE *ATOMIC_FILE_open(const char *destination);
+bool ATOMIC_FILE_commit(FILE *stream, const char *destination);
+bool ATOMIC_FILE_publish(const char *staged, const char *destination);
+#endif
--- /dev/null
+++ b/wizball/atomic_file.cpp
@@ -0,0 +1,50 @@
+#include "atomic_file.h"
+#include <string>
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+#endif
+#ifndef _WIN32
+#include <unistd.h>
+#else
+#include <io.h>
+#include <windows.h>
+#endif
+
+FILE *ATOMIC_FILE_open(const char *destination)
+{
+    std::string staged = std::string(destination) + ".pending";
+    return fopen(staged.c_str(), "w");
+}
+
+bool ATOMIC_FILE_publish(const char *staged, const char *destination)
+{
+    FILE *f = fopen(staged, "rb+");
+    if (!f) return false;
+#ifndef _WIN32
+    bool ok = fsync(fileno(f)) == 0;
+#else
+    bool ok = _commit(_fileno(f)) == 0;
+#endif
+    if (fclose(f) != 0) ok = false;
+    if (!ok) return false;
+#ifndef _WIN32
+    bool published = rename(staged, destination) == 0;
+#ifdef __EMSCRIPTEN__
+    if (published) EM_ASM({ if (window.wizballSave) window.wizballSave(); });
+#endif
+    return published;
+#else
+    return MoveFileExA(staged, destination, MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH) != 0;
+#endif
+}
+
+bool ATOMIC_FILE_commit(FILE *stream, const char *destination)
+{
+    if (!stream) return false;
+    bool ok = ferror(stream) == 0;
+    if (fflush(stream) != 0) ok = false;
+    if (fclose(stream) != 0) ok = false;
+    if (!ok) return false;
+    std::string staged = std::string(destination) + ".pending";
+    return ATOMIC_FILE_publish(staged.c_str(), destination);
+}
