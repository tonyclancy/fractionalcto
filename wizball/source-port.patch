+++ b/wizball/mac_desktop.cpp
@@ -0,0 +1,123 @@
+#include "mac_desktop.h"
+#include "atomic_file.h"
+#include <SDL_mixer.h>
+#include <stdio.h>
+#include <algorithm>
+
+static SDL_Window *window = NULL;
+static SDL_Renderer *renderer = NULL;
+static bool unfocused = false, integer_scale = false;
+static int normal_width = 1280, normal_height = 960;
+static int logical_width = 1280, logical_height = 960;
+static int output_width = 0, output_height = 0;
+
+void MAC_DESKTOP_sync_display()
+{
+    if (!renderer) return;
+    int width = 0, height = 0;
+    if (SDL_GetRendererOutputSize(renderer, &width, &height) != 0 || width <= 0 || height <= 0) return;
+    if (width != output_width || height != output_height) {
+        // SDL2-compat can retain the previous drawable's viewport on Retina
+        // fullscreen transitions. Rebuild its logical presentation explicitly.
+        SDL_RenderSetLogicalSize(renderer, 0, 0);
+        SDL_RenderSetIntegerScale(renderer, integer_scale ? SDL_TRUE : SDL_FALSE);
+        SDL_RenderSetLogicalSize(renderer, logical_width, logical_height);
+        output_width = width; output_height = height;
+    }
+}
+static bool is_fullscreen() { return window && (SDL_GetWindowFlags(window) & SDL_WINDOW_FULLSCREEN_DESKTOP); }
+
+void MAC_DESKTOP_save()
+{
+    if (!window) return;
+    if (!is_fullscreen()) SDL_GetWindowSize(window, &normal_width, &normal_height);
+    FILE *f = ATOMIC_FILE_open("mac-display.cfg");
+    if (!f) return;
+    fprintf(f, "%d %d %d %d\n", normal_width, normal_height, is_fullscreen() ? 1 : 0, integer_scale ? 1 : 0);
+    ATOMIC_FILE_commit(f, "mac-display.cfg");
+}
+
+void MAC_DESKTOP_setup(SDL_Window *w, SDL_Renderer *r, int width, int height)
+{
+    window = w; renderer = r; logical_width = width; logical_height = height;
+    normal_width = width; normal_height = height;
+    int fullscreen = 0, integer = 0, saved_w = 0, saved_h = 0;
+    FILE *f = fopen("mac-display.cfg", "r");
+    if (f) {
+        if (fscanf(f, "%d %d %d %d", &saved_w, &saved_h, &fullscreen, &integer) == 4 && saved_w >= 640 && saved_w <= 7680 && saved_h >= 480 && saved_h <= 4320) {
+            normal_width = saved_w; normal_height = saved_h;
+        }
+        fclose(f);
+    }
+    SDL_Rect usable;
+    if (SDL_GetDisplayUsableBounds(SDL_GetWindowDisplayIndex(w), &usable) == 0) {
+        normal_width = std::min(normal_width, std::max(640, usable.w - 40));
+        normal_height = std::min(normal_height, std::max(480, usable.h - 80));
+    }
+    SDL_SetWindowMinimumSize(w, 640, 480);
+    SDL_SetWindowSize(w, normal_width, normal_height);
+    SDL_SetWindowPosition(w, SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED);
+    integer_scale = integer == 1;
+    SDL_RenderSetIntegerScale(r, integer_scale ? SDL_TRUE : SDL_FALSE);
+    SDL_SetWindowFullscreen(w, fullscreen == 1 ? SDL_WINDOW_FULLSCREEN_DESKTOP : 0);
+    unfocused = false;
+    output_width = output_height = 0;
+    MAC_DESKTOP_sync_display();
+}
+
+bool MAC_DESKTOP_event(const SDL_Event &event)
+{
+    if (!window) return false;
+    if (event.type == SDL_KEYDOWN && !event.key.repeat) {
+        bool command = (event.key.keysym.mod & KMOD_GUI) != 0;
+        SDL_Keycode key = event.key.keysym.sym;
+        if (command && key == SDLK_q) { MAC_DESKTOP_save(); return true; }
+        if ((command && key == SDLK_f) || key == SDLK_F11) {
+            bool fullscreen = is_fullscreen();
+            if (!fullscreen) SDL_GetWindowSize(window, &normal_width, &normal_height);
+            if (SDL_SetWindowFullscreen(window, fullscreen ? 0 : SDL_WINDOW_FULLSCREEN_DESKTOP) == 0) {
+                if (fullscreen) SDL_SetWindowSize(window, normal_width, normal_height);
+                MAC_DESKTOP_save();
+            }
+        } else if (command && key == SDLK_i) {
+            integer_scale = !integer_scale;
+            output_width = output_height = 0;
+            SDL_RenderSetIntegerScale(renderer, integer_scale ? SDL_TRUE : SDL_FALSE);
+            MAC_DESKTOP_save();
+        } else if (command && key >= SDLK_1 && key <= SDLK_3 && !is_fullscreen()) {
+            int multiplier = key - SDLK_0;
+            SDL_SetWindowSize(window, 640 * multiplier, 480 * multiplier);
+            MAC_DESKTOP_save();
+        }
+    }
+    if (event.type == SDL_WINDOWEVENT && event.window.windowID == SDL_GetWindowID(window)) {
+        switch (event.window.event) {
+        case SDL_WINDOWEVENT_FOCUS_LOST:
+        case SDL_WINDOWEVENT_MINIMIZED:
+            if (!unfocused) { Mix_Pause(-1); Mix_PauseMusic(); }
+            unfocused = true;
+            MAC_DESKTOP_save();
+            break;
+        case SDL_WINDOWEVENT_FOCUS_GAINED:
+            if (unfocused) { Mix_Resume(-1); Mix_ResumeMusic(); }
+            unfocused = false;
+            break;
+        case SDL_WINDOWEVENT_SIZE_CHANGED:
+            MAC_DESKTOP_save();
+            break;
+        }
+    }
+    return false;
+}
+
+bool MAC_DESKTOP_suspended()
+{
+    if (!window) return false;
+    bool inactive = (SDL_GetWindowFlags(window) & (SDL_WINDOW_INPUT_FOCUS | SDL_WINDOW_MINIMIZED)) != SDL_WINDOW_INPUT_FOCUS;
+    if (inactive != unfocused) {
+        if (inactive) { Mix_Pause(-1); Mix_PauseMusic(); }
+        else { Mix_Resume(-1); Mix_ResumeMusic(); }
+        unfocused = inactive;
+    }
+    return unfocused;
+}
