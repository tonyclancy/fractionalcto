{
  "name": "wizball-tonyclancy",
  "account_id": "efd2634d1252a64d0f8ba286b7bcb7ab",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-22",
  "workers_dev": true,
  "assets": {
    "directory": "..",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "tonyclancy.com/wizball",
      "zone_name": "tonyclancy.com"
    },
    {
      "pattern": "tonyclancy.com/wizball/*",
      "zone_name": "tonyclancy.com"
    }
  ]
}
